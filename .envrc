#!/usr/bin/env bash
# This file is used by `direnv` https://direnv.net/docs/installation.html to manage Conda environments and change our source paths.
# Load conda if defined in the file `.conda.env`, simply put the name of your conda environment to load inside that file.
# You MAY need to adapt the path for `CONDA_ROOT` if that does not match your environment.
if [ -f .conda.env ]; then
        CONDA_ROOT="${HOME}/miniforge3"
	# >>> conda initialize >>> (COPIED from running conda init)
	if [ -f "${CONDA_ROOT}/bin/conda" ]; then
        __conda_setup="$("${CONDA_ROOT}/bin/conda" 'shell.bash' 'hook' 2> /dev/null)"
        # shellcheck disable=SC2181
		if [ $? -eq 0 ]; then
			eval "$__conda_setup"
		else
			if [ -f "${CONDA_ROOT}/etc/profile.d/conda.sh" ]; then
				# shellcheck source=/dev/null
				. "${CONDA_ROOT}/etc/profile.d/conda.sh"
			else
				export PATH="${CONDA_ROOT}/bin:$PATH"
			fi
		fi
		unset __conda_setup
		# <<< conda initialize <<<
		#
		conda_env_name="$(cat .conda.env)"
		echo "Attempting to switch to conda environment [${conda_env_name}] with direnv..."
		#
		if [ -d "${CONDA_ROOT}/envs/${conda_env_name}" ] || [ -d "${conda_env_name}" ]; then
			conda activate "${conda_env_name}"
		else
			echo "It looks like the conda environment [${conda_env_name}] does not exist, you will need to create it first!"
		fi
		#
	fi
fi
# # This makes Cylc think this location is actually our home since the use of '$HOME' is hardcoded in Cylc.
# export HOME="${PWD}"
# # REMEMBER - From this point on HOME and '~/' will now default to this directory! It also really messes things up.
#
# So instead of that, just make an alias that handles the '$HOME' re-assignment.
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
# Disable the check https://www.shellcheck.net/wiki/SC2139 since we want this to be a statically set dynamic definition.
# shellcheck disable=SC2139
if [ -d "${SCRIPT_DIR}/bin" ]; then
	# Set our path to have the bin dir be first.
	PATH="${SCRIPT_DIR}/bin:${PATH}"
fi

